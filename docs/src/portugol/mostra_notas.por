programa{
    //mostra notas.por
    funcao inicio(){
        real notas[4]
        inteiro i = 0
        

        para(inteiro i = 0; i <= 3; i = i + 1){
             escreva("Informe a nota ", i + 1, ": ")
             leia(notas[0])
        }

        para(i = 0; i <= 3; i = i + 1){
             escreva("Nota ", i + 1, )
        }
    }
}